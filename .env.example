# ---- Database ----
# Leave MONGODB_URI unset (or set to "memory") to run with the zero-dependency in-memory store.
# Dev snapshots are written to .data/memory-db.json so restarts keep users and history.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=blood_on_mahjong
# MEMORY_DB_FILE=.data/memory-db.json

# ---- Realtime (optional, only for multi-instance scaling) ----
# REDIS_URL=redis://localhost:6379

# ---- Google OAuth (optional; guest login works without it) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- App ----
# Public origin used for invite links (defaults to the request origin)
# PUBLIC_ORIGIN=http://localhost:3000
# Secret used to sign guest session cookies (any long random string)
# SESSION_SECRET=change-me

# ---- Realtime transport ----
# socket = Socket.IO on a long-running server (default locally / Docker)
# poll   = HTTP polling for serverless hosts (default automatically when built on Vercel)
# NUXT_PUBLIC_REALTIME=socket
